DATA_MODE=live
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://xucuz:local-development-only@localhost:5432/xucuz
# Generate: npm run admin:hash -- 'your-long-unique-password'
ADMIN_PASSWORD_HASH=
# Generate: openssl rand -hex 32
SESSION_SECRET=
CONTACT_EMAIL=
BUSINESS_NAME=
BUSINESS_ADDRESS=
# Required for contact email; otherwise no contact form is shown.
# Live sources are reviewed and imported in admin; no third-party API credentials required for demo.

# Optional: use Vercel AI Gateway when configured; otherwise use Groq.
# Keep real credentials in Vercel environment secrets, never in this file.
AI_GATEWAY_MODEL=alibaba/qwen3.8-flash
AI_GATEWAY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Set to 0 to disable reading verified model history.
MODEL_HISTORY_ENABLED=1

# First-party yearly counter: requires migrated PostgreSQL + a private 32+ char secret.
VISITOR_METRICS_ENABLED=0
VISITOR_METRICS_SECRET=
